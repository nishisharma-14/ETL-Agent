# Database connection
# Default SQLite is used for instant local running out of the box.
# For PostgreSQL with Docker, use: postgresql://postgres:postgres@localhost:5432/etl_db
DATABASE_URL=sqlite:///./etl.db

# API settings
API_URL=https://dummyjson.com/products
API_PAGE_LIMIT=30
API_TIMEOUT_SECONDS=10

# FastAPI settings
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
